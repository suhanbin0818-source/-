.page {
  padding-bottom: 48rpx;
}

.hero {
  position: relative;
  min-height: 760rpx;
  overflow: hidden;
  background: #1c2b33;
}

.hero-image,
.hero-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  background: linear-gradient(180deg, rgba(10, 19, 24, 0.56), rgba(10, 19, 24, 0.84));
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: 42rpx 34rpx 58rpx;
  color: #ffffff;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 88rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border: 4rpx solid #ffffff;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.brand-name {
  font-size: 32rpx;
  font-weight: 900;
}

.brand-sub {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.eyebrow {
  margin-bottom: 16rpx;
  color: #1f7a63;
  font-size: 24rpx;
  font-weight: 900;
}

.hero-eyebrow {
  color: #f2b705;
}

.hero-title {
  max-width: 650rpx;
  font-size: 72rpx;
  line-height: 0.98;
  font-weight: 900;
}

.hero-copy {
  margin-top: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 30rpx;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.btn,
.mini-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  padding: 0 34rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.primary {
  color: #1d252b;
  background: #f2b705;
}

.ghost {
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.08);
}

.full {
  width: 100%;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 18rpx;
  background: #ffffff;
}

.stat-item {
  padding: 22rpx 12rpx;
  border: 2rpx solid #d8e0e4;
  border-radius: 10rpx;
  text-align: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 6rpx;
  color: #60707b;
  font-size: 22rpx;
}

.section {
  padding: 72rpx 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 900;
}

.section-text {
  color: #60707b;
  font-size: 28rpx;
  line-height: 1.8;
}

.pricing {
  background: linear-gradient(135deg, rgba(242, 183, 5, 0.2), rgba(31, 122, 99, 0.12));
}

.calc-card,
.contact-card,
.form-card,
.product-card,
.step {
  border: 2rpx solid #d8e0e4;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(30, 46, 55, 0.07);
}

.calc-card,
.contact-card,
.form-card {
  margin-top: 28rpx;
  padding: 28rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #344b5a;
  font-size: 26rpx;
  font-weight: 900;
}

input,
textarea,
.picker-value {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  border: 2rpx solid #d8e0e4;
  border-radius: 10rpx;
  color: #15212a;
  background: #ffffff;
  font-size: 28rpx;
}

textarea {
  height: 180rpx;
  padding-top: 18rpx;
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
}

.estimate {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border-radius: 10rpx;
  color: #ffffff;
  background: #1f7a63;
  font-size: 40rpx;
  font-weight: 900;
}

.contact {
  background: #ffffff;
}

.contact-line,
.contact-address {
  color: #344b5a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.75;
}

.contact-address {
  color: #60707b;
}

.map-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.mini-btn {
  flex: 1;
  min-height: 76rpx;
  color: #1f7a63;
  border: 2rpx solid #d8e0e4;
  background: #fbfcfa;
}

.map-card {
  margin-top: 24rpx;
  overflow: hidden;
  border: 2rpx solid #d8e0e4;
  border-radius: 12rpx;
}

.map-canvas {
  position: relative;
  min-height: 260rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(31, 122, 99, 0.18), rgba(242, 183, 5, 0.12)),
    #edf4ef;
}

.map-canvas::before {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(52, 75, 90, 0.08) 2rpx, transparent 2rpx),
    linear-gradient(90deg, rgba(52, 75, 90, 0.08) 2rpx, transparent 2rpx);
  background-size: 54rpx 54rpx;
  content: "";
}

.map-road {
  position: absolute;
  z-index: 1;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 0 2rpx rgba(52, 75, 90, 0.08);
}

.road-a {
  top: 54rpx;
  left: -36rpx;
  width: 520rpx;
  height: 42rpx;
  transform: rotate(-12deg);
}

.road-b {
  right: -70rpx;
  bottom: 58rpx;
  width: 560rpx;
  height: 46rpx;
  transform: rotate(22deg);
}

.road-c {
  top: -96rpx;
  left: 48%;
  width: 42rpx;
  height: 470rpx;
  transform: rotate(12deg);
}

.map-pin {
  position: absolute;
  z-index: 2;
  top: 98rpx;
  left: 50%;
  width: 54rpx;
  height: 54rpx;
  border: 8rpx solid #ffffff;
  border-radius: 50% 50% 50% 0;
  background: #b74f35;
  box-shadow: 0 16rpx 32rpx rgba(21, 33, 42, 0.24);
  transform: translateX(-50%) rotate(-45deg);
}

.map-pin::after {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  content: "";
}

.map-place {
  padding: 22rpx;
  border-top: 2rpx solid #d8e0e4;
  background: #fbfcfa;
}

.map-name {
  font-size: 28rpx;
  font-weight: 900;
}

.map-address,
.wechat-tip {
  margin-top: 8rpx;
  color: #60707b;
  font-size: 24rpx;
  line-height: 1.5;
}

.products {
  background: #f6f7f4;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.product-card {
  min-height: 310rpx;
  padding: 26rpx;
}

.product-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 22rpx;
  border-radius: 10rpx;
  color: #ffffff;
  background: #344b5a;
  font-size: 34rpx;
  font-weight: 900;
}

.product-name {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.product-desc {
  min-height: 130rpx;
  color: #60707b;
  font-size: 24rpx;
  line-height: 1.55;
}

.product-price {
  color: #b74f35;
  font-size: 24rpx;
  font-weight: 900;
}

.service {
  color: #ffffff;
  background: #344b5a;
}

.service .eyebrow {
  color: #f2b705;
}

.steps {
  margin-top: 28rpx;
}

.step {
  margin-bottom: 16rpx;
  padding: 28rpx;
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.18);
  background: #263b48;
  box-shadow: none;
}

.step-no {
  color: #f2b705;
  font-size: 24rpx;
  font-weight: 900;
}

.step-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.step-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 26rpx;
  line-height: 1.7;
}
